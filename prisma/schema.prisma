generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through the transaction-mode pooler (6543).
  url       = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection (5432).
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  JOB_SEEKER
  EMPLOYER
  ADMIN
}

/// Account lifecycle (employer_logic.md v2.1 section 8).
///
/// SUSPENDED is reversible (policy violation, suspicious activity); DEACTIVATED is a
/// permanent close. `isActive: Boolean` could not tell those apart, which is why an admin
/// had no way to record WHY an account was off.
///
/// TODO(Phase 7): `isActive` is still the flag the login path enforces
/// (user.repository.ts). Until that switches to `status`, both are written together and
/// this column is recorded but not yet authoritative. Collapsing them is Phase 7's job,
/// because it touches the auth entity and the login refusal.
enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  SCREENING
  INTERVIEW
  OFFER
  ACCEPTED
  NEGOTIATING
  REJECTED
  WITHDRAWN
  ARCHIVED
}

// ── Shared-kernel enums (Phase 3) ────────────────────────────────────────────
enum SubscriptionTier {
  FREE
  PREMIUM
  PROFESSIONAL
}

enum JobLevel {
  INTERN
  ENTRY
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  C_LEVEL
}

enum RemoteType {
  ON_SITE
  HYBRID
  REMOTE
}

// Whether a job can be applied to inside JobFits (INTERNAL) or only on the site it was
// ingested from (EXTERNAL). See Job.sourceType.
enum JobSourceType {
  INTERNAL
  EXTERNAL
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  FREELANCE
}

enum DegreeLevel {
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTORATE
  CERTIFICATION
}

// ── Admin module enums (Admin MVP) ───────────────────────────────────────────
// NOTE: the admin docs spell these lowercase (e.g. 'health_check'); we follow this
// project's existing convention of UPPERCASE Prisma enum members (see UserRole above).

enum SystemEventType {
  HEALTH_CHECK
  API_LATENCY_HIGH
  ERROR_RATE_HIGH
  QUEUE_BACKED_UP
  EMAIL_DELIVERY_LOW
  DATABASE_ERROR
}

enum SystemEventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum EmailEventType {
  SENT
  DELIVERED
  BOUNCED_SOFT
  BOUNCED_HARD
  COMPLAINED
  UNSUBSCRIBED
}

enum AuditActionType {
  USER_RESET_PASSWORD
  USER_ACCOUNT_DELETED
  USER_UNLOCKED
  EMAIL_SUPPRESSED
  // Employer onboarding (employer_logic.md v2.1 section 9). Approval CREATES an account,
  // which is the most consequential thing an admin can do here — it must be attributable.
  EMPLOYER_REQUEST_APPROVED
  EMPLOYER_REQUEST_REJECTED
  EMPLOYER_ACTIVATION_RESENT
  // Account lifecycle (employer_logic.md v2.1 section 8). Suspension is reversible and
  // deactivation is not, so they are separate actions rather than one STATUS_CHANGED.
  USER_SUSPENDED
  USER_REACTIVATED
  USER_DEACTIVATED
}

/// What a SecurityEvent records.
///
/// SEPARATE FROM AuditActionType on purpose. Those are admin actions — low volume,
/// deliberate, and kept for accountability. These are authentication facts, most of them
/// generated by anonymous traffic, and they exist to answer "is this account under attack"
/// rather than "who did this".
enum SecurityEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  /// Refused by the lockout before the password was even checked.
  LOGIN_BLOCKED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  /// An admin suspended, reactivated or deactivated the account.
  ACCOUNT_STATUS_CHANGED
}

enum AuditResourceType {
  USER
  EMAIL
  SYSTEM
  EMPLOYER_REQUEST
}

// ── Employer module enums (Employer Phase 2) ─────────────────────────────────
// How a company's ownership was verified. Two methods only (docs' simplified scope):
// email-domain match, or manual admin review.
enum CompanyVerificationMethod {
  EMAIL_DOMAIN
  ADMIN_REVIEW
}

/// What the automated email-domain check found at first-login claim.
///
/// A SOFT SIGNAL, recorded and never enforced, for an employer who arrived through admin
/// approval (employer_logic.md v2.1 section 6). The check cannot be authoritative there:
/// it answers "no website" for many seeded and ingested company rows, and MISMATCH for a
/// recruiter whose address sits on a subsidiary or regional domain. Either would block an
/// employer a human already verified against a business registration.
///
/// It still gets recorded, because "the admin approved them AND the domain matched" and
/// "the admin approved them but the domain did not" are different facts, and an audit
/// should not have to guess which one happened.
enum DomainCheckResult {
  MATCH
  MISMATCH
  NO_WEBSITE
}

/// The employer onboarding ticket's lifecycle (employer_logic.md v2.1 section 2).
///
/// DELIBERATELY SEPARATE from UserStatus. This ticket exists BEFORE any account does and
/// must survive rejection — an account row must never be created for a rejected request,
/// so the two cannot share a state machine.
enum EmployerRequestStatus {
  SUBMITTED
  REVIEWING
  PENDING_INFO
  APPROVED
  REJECTED
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  name             String           @default("")
  passwordHash     String           @default("")
  role             UserRole         @default(JOB_SEEKER)
  subscriptionTier SubscriptionTier @default(FREE)
  avatarUrl        String?
  isActive         Boolean          @default(true)
  /// See UserStatus. Written on every lifecycle change; not yet enforced at login.
  status           UserStatus       @default(ACTIVE)

  // Email verification (isVerified in the domain maps to this column)
  emailVerified          Boolean   @default(false)
  verificationCode       String?
  verificationCodeExpiry DateTime?

  // Password reset (6-digit code flow — see Flow 0.3)
  passwordResetCode       String?
  passwordResetCodeExpiry DateTime?

  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// The address this account used before it was deleted.
  ///
  /// Soft delete RELEASES `email` to a reserved tombstone, because `email` is @unique and
  /// keeping it occupied meant a user who deleted their account could never register
  /// again (MENTOR_REVIEW_2026-08-18 §14). That dead end is what forced hard deletes
  /// through the Supabase console — and a hard delete cascades to `match_labels`, which
  /// is how 50 hand-labelled evaluation pairs were destroyed.
  ///
  /// ⚠️ RETENTION. This is still personal data after a deletion request. It is kept so
  /// support can answer "what happened to my account" and so repeat abuse is traceable;
  /// a production deployment needs a purge policy with a stated horizon, which this
  /// project does not yet have.
  deletedEmail String?

  // Employer profile
  employerProfile          EmployerProfile?
  /// Authentication history. SetNull on delete, so the trail outlives the account.
  securityEvents SecurityEvent[]
  /// Onboarding tickets this admin reviewed, and the one that created this account.
  reviewedEmployerRequests EmployerRequest[] @relation("EmployerRequestReviewer")
  employerRequest          EmployerRequest?  @relation("EmployerRequestAccount")
  // Auth sessions
  refreshTokens            RefreshToken[]

  // ── User module (Phase 3) ──────────────────────────────────────────────────
  profile           Profile?
  experiences       Experience[]
  educations        Education[]
  certifications    Certification[]
  skills            UserSkill[]
  analytics         UserAnalytics?
  resumes           Resume[]
  applications      Application[]
  savedJobs         SavedJob[]
  recommendations   Recommendation[]
  matchLabels       MatchLabel[]
  matchReports      MatchReport[]
  savedExternalJobs SavedExternalJob[]
  trackedJobs       TrackedJob[]

  // ── Admin module (Admin MVP) ───────────────────────────────────────────────
  // Admin actions this user performed / system alerts this admin acknowledged.
  auditLogs                AuditLog[]    @relation("AdminAuditLogs")
  acknowledgedSystemEvents SystemEvent[] @relation("AcknowledgedSystemEvents")

  // ── Employer module (Employer Phase 2) ─────────────────────────────────────
  // Jobs this employer posted, applications they reviewed, and pipeline moves they made.
  postedJobs             Job[]                     @relation("PostedByEmployer")
  reviewedApplications   Application[]             @relation("ReviewedByEmployer")
  extendedOffers         Offer[]                   @relation("ExtendedOffers")
  offerMessages          OfferMessage[]            @relation("OfferMessages")
  movedApplicationStages ApplicationStageHistory[] @relation("MovedByUser")

  notifications Notification[]

  // ── Idempotency (PWA offline mode, Phase 1) ────────────────────────────────
  idempotencyKeys IdempotencyKey[]

  // ── Resume Builder ─────────────────────────────────────────────────────────
  resumeDocuments ResumeDocument[]

  @@index([email])
  @@index([role])
  @@index([subscriptionTier])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 hash of the refresh token — plaintext is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  // Soft-delete for rotation: NULL = live, non-null = consumed/revoked (kept so a
  // replayed already-rotated token can be detected as reuse/theft).
  revokedAt DateTime?

  @@index([userId])
  @@index([tokenHash])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

// ── User module (Phase 3) ──────────────────────────────────────────────────────

/// Whether a row's semantic embedding is usable.
///
/// Embedding failures used to be INVISIBLE: MatchingEmbeddingService caught the error,
/// logged a warning and returned nulls, so a job ingested during an AI outage never got a
/// vector and was silently unmatchable FOREVER — no status, no retry, no backfill trigger
/// (MENTOR_REVIEW_2026-08-18 §6 family; docs/AI_DEGRADATION_PLAN.md §5).
///
/// PENDING is the honest default for a row that has never been embedded, and is what
/// distinguishes "not done yet" from "tried and failed" — the two the old code rendered
/// identically as "no matches".
enum EmbeddingStatus {
  PENDING
  SUCCESS
  FAILED
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  phone     String?
  photoUrl  String?
  bio       String?
  headline  String? // e.g. "Senior Software Engineer at Google"

  // Location
  city      String?
  state     String?
  country   String?
  latitude  Float?
  longitude Float?

  // Work preferences
  desiredJobLevels       JobLevel[]
  desiredRemoteTypes     RemoteType[]
  desiredEmploymentTypes EmploymentType[]
  desiredIndustries      String[] // Industry IDs

  // Salary
  minSalary      Int?
  maxSalary      Int?
  salaryCurrency String @default("USD")

  // Social links
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?

  // ── Semantic matching (Phase 3) ─────────────────────────────────────────────
  // BGE-M3 candidate embedding (1024-dim), built from profile + latest parsed
  // résumé. Managed via raw SQL — Prisma can't read/write the `vector` type.
  embedding Unsupported("vector(1024)")?

  // Is that vector actually there, and if not, why? Written by
  // MatchingEmbeddingService on every attempt — success and failure alike.
  // Without this, a failed embed is indistinguishable from "this candidate has no matches yet".
  embeddingStatus EmbeddingStatus @default(PENDING)
  embeddedAt      DateTime?
  embeddingError  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@map("profiles")
}

model Experience {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  company        String
  title          String
  jobLevel       JobLevel
  employmentType EmploymentType
  industry       String // Industry ID

  description  String?
  isCurrentJob Boolean @default(false)

  startDate DateTime
  endDate   DateTime?

  technologies String[] // tech used

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([company])
  @@map("experiences")
}

model Education {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  institution  String
  degreeLevel  DegreeLevel
  fieldOfStudy String
  description  String?

  startDate DateTime
  endDate   DateTime?
  gpa       Float?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([institution])
  @@map("educations")
}

model Certification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  issuer        String
  credentialId  String?
  credentialUrl String?

  issueDate      DateTime
  expirationDate DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@map("certifications")
}

model UserSkill {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Restrict)

  endorsementCount  Int    @default(0)
  proficiencyLevel  String @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  yearsOfExperience Float?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}

model UserAnalytics {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalApplications         Int   @default(0)
  totalInterviews           Int   @default(0)
  totalOffers               Int   @default(0)
  applicationAcceptanceRate Float @default(0)
  interviewAcceptanceRate   Float @default(0)

  profileViewCount    Int       @default(0)
  lastProfileViewDate DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@map("user_analytics")
}

model EmployerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employer_profiles")
}

/// An employer's application to join the platform — the onboarding ticket.
///
/// Employers cannot self-register (the public signup DTO has no role field, so it can only
/// produce a JOB_SEEKER). This table is the only path to an EMPLOYER account, and until
/// it existed there was NO runtime path at all: every employer came from prisma/seed.ts.
///
/// Not a User relation, by design. The row is created by an unauthenticated stranger and
/// survives rejection; a rejected request must leave no account behind.
model EmployerRequest {
  id String @id @default(uuid())

  // ── What the employer submitted ──
  companyName       String
  /// Display name for the review queue. Composed from the two fields below when the intake
  /// form supplies them, and typed free-text when it does not.
  contactName       String
  /// The contact's name AS TWO FIELDS, because EmployerProfile stores it as two.
  ///
  /// Nullable, and that is the whole design: every request submitted before this column
  /// existed has only `contactName`, so approval falls back to splitting it on the first
  /// space. That fallback is a guess — "Mary Jane Watson" becomes a surname of
  /// "Jane Watson" — which is why new intake asks instead of inferring. Backfilling the old
  /// rows would mean persisting the same guess as though it were an answer.
  contactFirstName  String?
  contactLastName   String?
  contactRole       String
  /// Becomes the login address. Not unique: a rejected request must not permanently
  /// block the address, and the real conflict check is the unique index on users.email,
  /// applied inside the approval transaction.
  companyEmail      String
  companyWebsite    String?
  description       String
  /// Business registration or similar. A link, not a blob — the API never serves it.
  supportingDocsUrl String?

  // ── Review ──
  status            EmployerRequestStatus @default(SUBMITTED)
  /// Internal. Shown to the employer ONLY as the rejection reason.
  adminNotes        String?
  reviewedByAdminId String?
  reviewedByAdmin   User?                 @relation("EmployerRequestReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?

  /// The account created on approval. Null until then, and forever on a rejection.
  approvedUserId String? @unique
  approvedUser   User?   @relation("EmployerRequestAccount", fields: [approvedUserId], references: [id], onDelete: SetNull)

  /// WHICH company the admin approved this request for.
  ///
  /// Without it, first-login claim is a free-text search and an employer approved for one
  /// company could claim another. The claim step checks against this
  /// (employer_logic.md v2.1 section 6).
  approvedCompanyId String?
  approvedCompany   Company? @relation(fields: [approvedCompanyId], references: [id], onDelete: SetNull)

  // ── Activation ──
  /// 6-digit code emailed on approval. Mirrors the existing verification-code columns on
  /// User rather than inventing a second mechanism. Cleared once used.
  activationCode       String?
  activationCodeExpiry DateTime?

  /// Outcome of the automated domain check, run once at first-login claim. See
  /// DomainCheckResult — recorded, never enforced, for an admin-approved employer.
  domainCheck     DomainCheckResult?
  domainCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([companyEmail])
  @@map("employer_requests")
}

model Company {
  id String @id @default(uuid())

  /// DISPLAY ONLY. Not unique — two real businesses can share a name ("Acme Robotics" in
  /// Phnom Penh and in Siem Reap are different companies). Searching by name finds
  /// CANDIDATES; `identityKey` is what decides whether two rows are the same company.
  name String

  /// Normalized host of `website` — `acme-kh.com`. Null when unknown, which is every
  /// scraped company: no ingestion source publishes a company website.
  domain String?

  /// What makes this row a distinct company. One of:
  ///   `domain:acme-kh.com`  strong — derived from the website
  ///   `name:acme robotics`  weak   — the only signal a scraped company has
  ///
  /// The prefix keeps the two from colliding, so an employer's acme-kh.com never lands on
  /// the same key as a scraped "Acme Robotics". Unique so ingestion can keep using
  /// `upsert`; a findFirst-then-create would race.
  identityKey String @unique

  description String?
  website     String?
  logoUrl     String?
  industry    String? // Industry ID
  size        String? // STARTUP | SMALL | MEDIUM | LARGE | ENTERPRISE
  foundedYear Int?

  // Location
  city    String?
  state   String?
  country String?

  // Glassdoor data
  glassdoorId      String?
  glassdoorRating  Float?
  glassdoorReviews Int?

  // ── Employer module: ownership verification (Employer Phase 2) ──────────────
  isVerified         Boolean                    @default(false)
  verificationMethod CompanyVerificationMethod?
  verifiedAt         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employers       EmployerProfile[]
  jobs            Job[]
  /// Onboarding tickets the admin approved for this company.
  employerRequests EmployerRequest[]

  // NOTE: Prisma's @@fulltext is MySQL-only and invalid on PostgreSQL. Company search is
  // implemented with case-insensitive `contains` in the repository; for production-grade
  // full-text search add a tsvector GIN index via a raw migration and switch to $queryRaw.
  @@index([name])
  @@index([industry])
  @@index([isVerified])
  /// Conflict detection on onboarding: "is this website already someone's company?"
  @@index([domain])
  @@map("companies")
}

/// How often a salary figure is paid. Cambodian postings quote MONTHLY; TheMuse and the
/// internal employer form quote ANNUAL. The corpus already mixes them, so the period has
/// to travel with the number — 500/month and 500/year are the same integer.
enum SalaryPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  ANNUAL
}

model Job {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String
  status      JobStatus @default(DRAFT)
  remoteType  String // e.g. "REMOTE", "HYBRID", "ON_SITE"
  location    String?
  minSalary   Int?
  maxSalary   Int?

  /// The unit `minSalary`/`maxSalary` are counted in. Both were bare integers, so a
  /// Cambodian monthly figure and a US annual figure were indistinguishable in the same
  /// column — and the frontend resolved that ambiguity by assuming USD-per-year and
  /// appending "K" (MENTOR_REVIEW_2026-08-18 §12).
  ///
  /// `salaryPeriod` is NULLABLE and null means UNKNOWN, not "annual". A default of ANNUAL
  /// would be the same fabrication in a new place: 83% of the corpus is Cambodian, where
  /// monthly is the norm, and the ingestion cannot currently tell. Clients must render an
  /// unknown period without implying one.
  salaryCurrency String        @default("USD")
  salaryPeriod   SalaryPeriod?

  // What the posting actually is. NULLABLE ON PURPOSE, and null must render as nothing.
  //
  // The frontend hardcoded `type: "Full-time"` and `level: "Mid-level"` in its mapper
  // because there was nothing to map, so every job card claimed both regardless of the
  // posting — including a part-time teaching role. The enums existed here and were used by
  // nothing. A job whose employer has not said is not a full-time mid-level job; it is a
  // job we do not know that about, and the two must not look the same. Same judgement as
  // CompanyProfileDto, which stopped inventing company facts for the same reason.
  employmentType  EmploymentType?
  experienceLevel JobLevel?

  // Structured posting content (employer-authored). Empty arrays when unset.
  responsibilities String[] @default([])
  requirements     String[] @default([])

  // Requirements read OUT of `description` by the AI service, for postings that carry no
  // employer-authored `requirements` (43 of 52 ingested jobs). Cached rather than derived
  // per request: extraction is an LLM call (~7s), far too slow to sit in a page load.
  // Never overwrites `requirements` — employer-authored text stays authoritative.
  extractedRequirements    String[]  @default([])
  requirementsExtractedAt  DateTime?
  // Grounded share of the model's raw output at extraction time. Persisted so a batch that
  // silently started inventing is visible afterwards instead of being invisible.
  requirementsGroundedness Float?
  benefits                 String[]  @default([])
  bonusPct                 Int? // target annual bonus, % of base

  // Can this job be applied to inside JobFits?
  //   INTERNAL — posted here; applications are received and tracked here.
  //   EXTERNAL — ingested from another site; the real posting lives at `externalUrl`
  //              and the user must be sent there. Applying in JobFits would go nowhere.
  // Kept as its own column rather than inferred from `source`/`externalUrl`, because
  // "may this user apply here?" is an authorisation-shaped question that belongs in one
  // queryable place, not re-derived in every service, DTO and UI branch.
  sourceType JobSourceType @default(INTERNAL)

  // ── Ingestion (FR-JOBS-001): external-source tracking + dedup ──────────────
  source      String? // e.g. "THEMUSE"; NULL = direct employer posting
  externalId  String? // the source's job id, for dedup + updates
  externalUrl String? // apply / landing page on the source
  lastSeenAt  DateTime? // last ingestion run that saw this posting (freshness)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Employer module (Employer Phase 2) ──────────────────────────────────────
  // Employer (user) who posted this job. NULL = external/ingested job (no employer).
  postedByEmployerId String?
  postedByEmployer   User?   @relation("PostedByEmployer", fields: [postedByEmployerId], references: [id], onDelete: SetNull)

  // ── Semantic matching (Phase 3) ─────────────────────────────────────────────
  // BGE-M3 job embedding (1024-dim), built from title + description + skills.
  // Managed via raw SQL — Prisma can't read/write the `vector` type.
  embedding Unsupported("vector(1024)")?

  // Is that vector actually there, and if not, why? Written by
  // MatchingEmbeddingService on every attempt — success and failure alike.
  // Without this, a failed embed is indistinguishable from "nobody matches this job".
  embeddingStatus EmbeddingStatus @default(PENDING)
  embeddedAt      DateTime?
  embeddingError  String?

  // Phase B: full-text search vector (BM25) — GENERATED STORED from title+description.
  // Read via raw SQL only.
  searchTsv Unsupported("tsvector")?

  applications    Application[]
  skills          JobSkill[]
  savedBy         SavedJob[]
  recommendations Recommendation[]
  matchLabels     MatchLabel[]
  trackedJobs     TrackedJob[]

  // Dedup key for ingested jobs. NULLs are distinct in Postgres, so direct
  // employer postings (source = externalId = NULL) never collide here.
  @@unique([source, externalId])
  @@index([postedByEmployerId])
  @@index([source])
  @@map("jobs")
}

// A job a seeker bookmarked for later. Simple join of (user, job); unique so a
// job can't be saved twice, cascade so it disappears if either side is deleted.
/// A bookmark on one of OUR job rows.
///
/// SURVIVES THE POSTING, like TrackedJob and for the same reason. `jobId` used to be
/// `onDelete: Cascade` with no snapshot, so deleting a job erased the user's bookmark
/// without a trace — while a tracked card for the identical job survived, because
/// JOB_TRACKER_PLAN §2 had already argued that postings vanish ("bongthom returned 404
/// for 9 of 43 postings during the ingestion work"). That argument was never back-ported
/// here (MENTOR_REVIEW_2026-08-18 §16).
///
/// The corpus is 83% ingested from boards that delist aggressively, so the moment anything
/// prunes stale jobs — or anyone exposes JobService.delete, which exists and is currently
/// reachable by no route — a cascade would take real bookmarks with it.
model SavedJob {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Null once the posting is gone. The row stays; the link does not.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Copied at save time so the bookmark still says something after `jobId` goes null.
  /// Nullable because rows saved before these columns existed have no snapshot beyond
  /// what the back-fill could recover from the job they still point at.
  title       String?
  companyName String?
  url         String?

  createdAt DateTime @default(now())

  /// One bookmark per posting per user. NULLs are distinct in Postgres, so orphaned rows
  /// coexist rather than colliding — the same trick TrackedJob uses.
  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("saved_jobs")
}

/// A job the user saved from the browser extension, on a site we don't ingest.
///
/// SEPARATE FROM SavedJob ON PURPOSE. That table's `jobId` is a foreign key to our own
/// `Job` rows, and a LinkedIn posting has none. The alternatives were both worse:
/// inserting fake `Job` rows would feed invented postings into recommendations and the
/// matching batch, and making `jobId` nullable would break `@@unique([userId, jobId])`
/// (Postgres treats every NULL as distinct, so the same posting could be saved twice).
///
/// PRIVACY: this is the user's own bookmark, captured on their click, and `description`
/// is the text THEY chose to save from the page they were reading. It is scoped to their
/// row and is not a job board — nothing reads across users, and no background job writes
/// here.
model SavedExternalJob {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source     String // "linkedin", …
  externalId String // the source's job id, from the page URL

  title       String
  company     String?
  description String? // what the user saved from the posting
  url         String? // where to go back to
  salary      String? // free text — postings write "$70k–90k", "1,200 USD/month", …
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Re-saving the same posting updates it rather than making a duplicate.
  @@unique([userId, source, externalId])
  @@index([userId])
  @@map("saved_external_jobs")
}

enum ResumeParsingStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

model Resume {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String
  fileSize Int
  fileType String // "PDF" | "DOCX"

  title     String?
  isDefault Boolean @default(false)

  parsingStatus ResumeParsingStatus @default(PENDING)
  parsingError  String?

  atsScore     Int?
  qualityScore Int?
  version      Int  @default(1)

  parsedData   ParsedResumeData?
  applications Application[]

  /// Builder documents whose most recent export produced THIS résumé. Normally
  /// 0 or 1 — the document repoints its FK on re-export.
  builderDocuments ResumeDocument[] @relation("ResumeBuilderExport")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([isDefault])
  @@index([parsingStatus])
  @@map("resumes")
}

model ParsedResumeData {
  id       String @id @default(uuid())
  resumeId String @unique
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  fullName String?
  email    String?
  phone    String?
  location String?

  summary        String?
  experiences    String? // JSON string
  educations     String? // JSON string
  // JSON string. Personal/academic/technical work, kept separate from `experiences`:
  // on student CVs the projects hold nearly all the technical signal, and with nowhere
  // to put them the parser folded them into experiences as jobs that were never held.
  projects       String? // JSON string
  skills         String? // JSON string
  certifications String? // JSON string
  rawText        String?

  // "ai" when the AI service produced the structured data, "heuristic" when the
  // regex/section fallback did (AI service unavailable). Null for legacy rows.
  parsedBy String?

  // Which app/prompts/resume_parse_<v>.txt produced this row. Null for rows written
  // before prompt versioning, so a stored parse can be traced back to its prompt.
  promptVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parsed_resume_data")
}

model Application {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  status      ApplicationStatus @default(SUBMITTED)
  appliedAt   DateTime          @default(now())
  notes       String?
  coverLetter String?

  // ── AI Recruiter: automatic screening at the moment of applying ──────────────
  // A SNAPSHOT, never recomputed. It records what was true when this person applied;
  // rewriting it as their résumé or the job changes would quietly rewrite history and
  // make the employer's earlier decision unexplainable.
  //
  // All nullable: screening must never fail an application, so an AI/DB hiccup leaves
  // the row unscreened rather than losing the candidate their application.
  screenedAt                DateTime?
  screenMatchScore          Float? // 0-100, DETERMINISTIC scorer (never the LLM fitScore)
  screenRequirementsTotal   Int?
  screenRequirementsCovered Int?
  screenMissingRequirements String[]  @default([])
  // EMPLOYER when the employer wrote the requirements, AI_EXTRACTED when they were read
  // out of the description. The employer is entitled to know which they are judging on.
  screenRequirementsSource  String?

  // ── Employer module: pipeline review (Employer Phase 2) ─────────────────────
  employerNotes        String?
  reviewedByEmployerId String?
  reviewedByEmployer   User?   @relation("ReviewedByEmployer", fields: [reviewedByEmployerId], references: [id], onDelete: SetNull)

  // ── Archiving: one per side, because tidying is a VIEW, not a STATE ──────────
  // Archiving used to be the ApplicationStatus value ARCHIVED, which made one party's
  // housekeeping rewrite a record the other party reads: a candidate tidying an accepted
  // job dropped it out of the employer's Hired column and — because ARCHIVED mapped to
  // "Rejected" — filed someone they had hired under rejections. It also overwrote the
  // status it replaced, so the row stopped saying the person was hired at all.
  //
  // These are per-actor and non-destructive. The status keeps telling the truth
  // (ACCEPTED stays ACCEPTED); each side hides its own list without touching the other's.
  // Legacy rows still carrying status = ARCHIVED are left alone — their pre-archive status
  // is unrecoverable, and inventing one would be worse than leaving the history visible.
  archivedByCandidateAt DateTime?
  archivedByEmployerAt  DateTime?

  timeline      ApplicationTimeline[]
  contactPerson ContactPerson?
  stageHistory  ApplicationStageHistory[]
  offer         Offer?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, jobId])
  @@index([userId])
  @@index([status])
  @@index([reviewedByEmployerId])
  @@map("applications")
}

// ── Offers (Offers & Decisions) ───────────────────────────────────────────────
// A concrete offer an employer extends on an application. 1:1 with Application; all
// the compensation the seeker's /offers dashboard needs lives here. The seeker's
// accept/decline/negotiate decisions drive both this row and the Application status.
enum OfferStatus {
  EXTENDED
  NEGOTIATING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Offer {
  id            String      @id @default(uuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  status OfferStatus @default(EXTENDED)

  // Compensation
  baseSalary     Int
  currency       String @default("USD")
  signingBonus   Int?
  annualBonusPct Float?
  equityShares   Int?
  equityPrice    Float?

  startDate        DateTime?
  responseDeadline DateTime?
  /// DEPRECATED — superseded by OfferMessage. This single column was used as a
  /// conversation: the employer's note, with candidate replies appended as
  /// "[Candidate] …". It could not order, timestamp or attribute anything, appending
  /// meant rewriting the whole string, and the employer's own write path REPLACED it —
  /// so replying deleted the candidate's message. Migrated into OfferMessage and no
  /// longer written. Kept only so the migration is reversible.
  notes            String?

  messages OfferMessage[]

  // Who extended it (the employer user).
  extendedByEmployerId String?
  extendedByEmployer   User?   @relation("ExtendedOffers", fields: [extendedByEmployerId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  decidedAt DateTime?

  @@index([status])
  @@map("offers")
}

// ── Offer negotiation messages ────────────────────────────────────────────────
// The conversation about an offer. Replaces the Offer.notes string, which could hold
// exactly one candidate message before the write path refused, and which the employer's
// own note overwrote wholesale.
enum OfferMessageAuthor {
  CANDIDATE
  EMPLOYER
}

model OfferMessage {
  id      String @id @default(uuid())
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  authorRole   OfferMessageAuthor
  // Nullable so a deleted account does not take the conversation with it. authorRole is
  // what the UI attributes by, and it survives independently.
  authorUserId String?
  authorUser   User?              @relation("OfferMessages", fields: [authorUserId], references: [id], onDelete: SetNull)

  body String

  /// When the RECIPIENT read it. One column is enough: the recipient is implied by
  /// authorRole, and "has the author read their own message" is not a question anyone asks.
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([offerId, createdAt])
  @@index([offerId, readAt])
  @@map("offer_messages")
}

// ── Employer module: application pipeline stage history (Employer Phase 2) ─────
// One row per pipeline transition. Reuses ApplicationStatus (not a separate pipeline
// enum) to stay consistent with the rest of the system.
model ApplicationStageHistory {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus

  movedByUserId String?
  movedByUser   User?   @relation("MovedByUser", fields: [movedByUserId], references: [id], onDelete: SetNull)

  notes     String?
  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([createdAt])
  @@map("application_stage_history")
}

model ApplicationTimeline {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  status      ApplicationStatus
  eventType   String
  description String?
  eventDate   DateTime          @default(now())

  @@index([applicationId])
  @@map("application_timelines")
}

model ContactPerson {
  id            String      @id @default(uuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  name        String
  email       String?
  phone       String?
  title       String?
  linkedinUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_persons")
}

// Seeker-facing job recommendation (Phase 3) — THE match table. There is exactly one.
//
// Keyed by (userId, jobId): the candidate identity for the whole matching domain is the
// USER, and the profile row hanging off them. `MatchScore` used to sit alongside this
// keyed by `jobSeekerProfileId` and holding the same score + breakdown, so a reader could
// not tell which was authoritative (MENTOR_REVIEW_2026-08-18 §15). It was dropped: 0 rows,
// no writer on any branch, and unpopulatable anyway because `job_seeker_profiles` was
// empty and no code created one.
//
// If a second match table is ever proposed, the question to answer first is which identity
// it is keyed by — that is the thing that made these two impossible to reconcile.
//
// Written by the matching batch; read by the /recommendations endpoint.
model Recommendation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  score             Float // 0-100 weighted total
  breakdown         Json? // sub-scores: skills, experience, location, salary
  reasonExplanation String? // human-readable "why this matched"

  // When the score was last computed. Distinct from updatedAt, which any write bumps —
  // this one answers "what CV/profile is this number actually about?", so the UI can say
  // "matched against your CV from 3 Aug" instead of implying the number is live.
  computedAt DateTime @default(now())

  // Set when something the score depends on changes (profile, preferences, résumé,
  // default-résumé switch). The next read recomputes.
  //
  // A MARKER, NOT A DELETE. Deleting on change would be simpler, but a recompute that
  // then failed would leave the user staring at zero recommendations — strictly worse
  // than slightly old ones. Stale rows keep serving until a recompute succeeds.
  staleAt DateTime?

  // "Not interested". Dismissal used to be represented by the row's ABSENCE, which meant
  // any recompute resurrected it — harmless only because recomputes essentially never
  // happened (MENTOR_REVIEW_2026-08-18 §6). Now that invalidation is real, absence can no
  // longer carry that meaning: a dismissed row survives as a tombstone that recompute
  // refreshes but never un-dismisses, and reads filter out.
  //
  // This also closes the GET /sync/recommendations gap (sync.service.ts:16-17), whose
  // `deletes` was permanently empty for want of a soft delete.
  dismissedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([userId, score])
  // Reads are "this user's live recommendations, best first"; dismissed rows are
  // tombstones and must not cost anything to skip.
  @@index([userId, dismissedAt, score])
  @@map("recommendations")
}

// Full-page résumé↔job match report, generated from the browser extension and
// rendered by the web app at /match-report/{id}.
//
// `payload` holds the WHOLE rendered report rather than ids to recompute from:
// the scores are a snapshot of the moment the user scanned, so revisiting the
// link shows what they were shown, not a different answer produced by a résumé
// they have since edited.
//
// PRIVACY: the description the extension captured is used once to extract
// requirements; only the DERIVED report is stored, on the user's own row. This
// is deliberately not a job-listing store.
model MatchReport {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  externalId String // the source's job id, e.g. a LinkedIn posting id
  source     String // "linkedin", …
  title      String
  company    String?

  payload Json // the full report — see MatchReportPayload

  /// SHA-256 of the posting text this report was built from. The dedupe key, so
  /// re-opening an unchanged posting costs no AI call (§11) while an EDITED posting
  /// still regenerates. Null on rows written before the column existed; those are
  /// never reused.
  descriptionHash String?

  /// Which VERSION of the report builder produced `payload`.
  ///
  /// The reuse check keys on the posting text and the résumé, so an unchanged job and an
  /// unchanged CV correctly return the stored report. But that made every IMPROVEMENT to
  /// the report invisible: after fixing a defect on 2026-08-25 (a degree counted twice, a
  /// "nice to have" counted as missing), re-scanning the same posting kept serving the
  /// old payload, because neither input had changed. The code that built it had.
  ///
  /// Bump `PAYLOAD_VERSION` in match-report.service.ts whenever the payload's SHAPE or
  /// MEANING changes; older rows then miss the cache and are rebuilt on next scan.
  /// Rows written before this column existed default to 1.
  payloadVersion Int @default(1)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, source, externalId, descriptionHash, createdAt])
  @@map("match_reports")
}

// ── Evaluation (RAG plan Phase A) ─────────────────────────────────────────────
// Hand-labeled ground-truth for measuring retrieval quality (Recall@10/MRR/nDCG@10).
// Candidate = user (the retrieval unit). Slice tags are a Phase-A stopgap: Job has
// no category/seniority/language columns yet (Phase B adds real queryable ones).
enum MatchLabelValue {
  GREAT
  OK
  BAD
}

enum MatchLabelSource {
  HUMAN
  FEEDBACK
}

model MatchLabel {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  label  MatchLabelValue
  reason String?
  source MatchLabelSource @default(HUMAN)

  // Hand-labeled evaluation slices (nullable — free-text stopgap, not schema truth).
  category  String?
  seniority String?
  language  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@map("match_labels")
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs       JobSkill[]
  userSkills UserSkill[]

  @@map("skills")
}

model JobSkill {
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

/// What a notification is about. The client picks an icon from this; the sentence itself
/// is in `title`/`body`, written by whatever raised it.
enum NotificationType {
  APPLICATION // a status change on an application you are party to
  OFFER // an offer extended, revised or rescinded
  MESSAGE // a message in an offer negotiation
  MATCH
  SYSTEM
}

/// One thing that happened, addressed to one user.
///
/// The notification module existed as three empty listener stubs and a service whose two
/// methods had empty bodies — there was nowhere for a notification to go. The employer
/// could only discover a candidate's negotiation message by happening to open the board.
///
/// Rows are written INSIDE the transaction that causes them (see
/// ApplicationTransitionService and OfferService), not from an event listener. An
/// @OnEvent handler fires on emit, which for a status change means it fires from inside an
/// open transaction that may still roll back — leaving the user notified of something that
/// never happened. Writing the row beside the audit rows makes the notification exactly as
/// true as the change it describes.
model Notification {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType

  title String
  body  String

  /// In-app path to whatever this is about, e.g. "/offers" or "/applications/{id}".
  /// Null when there is nowhere useful to send the reader.
  link String?

  /// Null until read. A timestamp rather than a boolean so "when did they see it?" is
  /// answerable — the mock feed this replaces could not survive a page reload at all.
  readAt DateTime?

  createdAt DateTime @default(now())

  /// The feed is always "this user's, newest first", and the badge counts unread.
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model Industry {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("industries")
}

// ── Admin module models (Admin MVP) ──────────────────────────────────────────

/// System health alerts (Feature 1). Emitted by monitoring / health checks; admins
/// can acknowledge them from the dashboard.
model SystemEvent {
  id        String              @id @default(uuid())
  eventType SystemEventType
  severity  SystemEventSeverity @default(INFO)
  message   String
  details   Json? // structured payload: latency_ms, endpoint, error_count, ...

  acknowledgedAt        DateTime?
  acknowledgedByAdminId String?
  acknowledgedByAdmin   User?     @relation("AcknowledgedSystemEvents", fields: [acknowledgedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([severity])
  @@index([createdAt])
  @@index([acknowledgedAt])
  @@map("system_events")
}

/// Email delivery events (Feature 3). Fed by the email provider (SendGrid/SES) webhook.
/// `notificationId` is a soft reference kept for future linkage — there is no
/// notifications table yet, so it is a plain nullable column (no FK).
model EmailEvent {
  id              String         @id @default(uuid())
  recipientEmail  String
  notificationId  String?
  eventType       EmailEventType
  reason          String? // for bounces/complaints: why it failed
  externalEventId String? // provider event id (SendGrid/SES)

  createdAt DateTime @default(now())

  @@index([recipientEmail])
  @@index([createdAt])
  @@index([eventType])
  @@map("email_events")
}

/// Addresses we must never send to again — hard bounces and spam complaints.
///
/// This lived in Redis (`email:suppressed:{email}`, no TTL) until the Redis audit found
/// it was written but never read on the send path, and that a Redis restart dropped the
/// whole list silently. It is a permanent compliance record, not a cache: mailing an
/// address that complained is what gets a sending domain blocked.
///
/// `email` is the primary key — the address IS the identity, so the constraint does the
/// deduplication. Callers lower-case and trim at the boundary.
model SuppressedEmail {
  email String @id

  /// Free text: "hard bounce", "spam complaint", or whatever the admin typed. Nullable
  /// because a suppression with no stated reason is still a valid suppression.
  reason String?

  /// Who suppressed it. Deliberately NOT a relation: the record must outlive the admin
  /// account that created it, and a compliance record that disappears when someone
  /// leaves the company is not a compliance record.
  suppressedByAdminId String?

  suppressedAt DateTime @default(now())

  /// The admin list is "most recently suppressed first". The send path looks up by
  /// primary key and needs no index of its own.
  @@index([suppressedAt])
  @@map("suppressed_emails")
}

/// Basic admin action log (Audit Logging). Intentionally minimal for the MVP —
/// no old/new values, IP, or free-text reason (Phase 2+).
model AuditLog {
  id           String            @id @default(uuid())
  adminId      String
  admin        User              @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)
  actionType   AuditActionType
  resourceType AuditResourceType
  resourceId   String? // user id or email address the action targeted

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Authentication and account-security history.
///
/// A SIBLING of AuditLog rather than an extension of it, for two reasons that only became
/// clear from the code:
///
///  1. `AuditLog.adminId` is NON-NULLABLE, with an AdminAuditLogs relation. Widening it to
///     accept a non-admin actor means making that nullable — which destroys the one thing
///     that table guarantees: every row has an accountable admin behind it.
///  2. Volume and retention differ by orders of magnitude. Every failed login against every
///     address versus a handful of admin actions a week. Mixed, the compliance records
///     drown, and neither can be rotated without the other.
///
/// ⚠️ RETENTION. `email` and `ipAddress` are personal data, recorded largely for people who
/// are not users (a failed login names an address that may not exist here). They are kept
/// so an account takeover can be reconstructed and repeat abuse traced; a production
/// deployment needs a purge policy with a stated horizon, which this project does not yet
/// have — the same gap `User.deletedEmail` carries.
///
/// Volume is bounded by the existing Redis lockout (5 account / 20 IP failures per 15-min
/// window), so a single attacker cannot write rows without limit.
model SecurityEvent {
  id String @id @default(uuid())

  /// Null when the attempt named an address with no account. The event still matters —
  /// that is what credential stuffing looks like — so it is recorded against the email.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// The address the attempt used, always. Lower-cased, matching the login lookup.
  email     String
  eventType SecurityEventType
  ipAddress String?
  /// Free text for the human reading this later — never parsed.
  detail    String?

  createdAt DateTime @default(now())

  // "What happened to this account" and "what is this address doing" are the two questions
  // this table exists to answer; both scan by time.
  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([eventType, createdAt])
  @@map("security_events")
}

// ── Idempotency (PWA offline mode, Phase 1) ───────────────────────────────────
// A record of "this client already performed this action", so a queued offline
// mutation replayed after a reconnect returns the ORIGINAL response instead of
// running the handler a second time.
//
// `key` is client-generated (one per logical action) and globally unique. It is
// scoped to a user and an endpoint on read: a key that turns up against a
// different user, a different route, or a different body is a client bug, and is
// rejected with 409 rather than quietly served the wrong cached response.
//
// `requestHash` is a SHA-256 over the canonicalised request body. It is what
// distinguishes "the same action, retried" from "a different action that reused
// the key by mistake".
model IdempotencyKey {
  id     String @id @default(uuid())
  key    String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "POST /api/v1/saved-jobs" — method + path, so one key cannot straddle routes.
  endpoint    String
  requestHash String

  responseStatus Int
  /// Null for handlers that return no body (e.g. a 204).
  responseBody   Json?

  createdAt DateTime @default(now())
  /// createdAt + 24h. Indexed because the only query that reads it is the
  /// cleanup sweep's `deleteMany({ where: { expiresAt: { lt: now } } })`.
  expiresAt DateTime

  @@index([expiresAt])
  @@index([userId])
  @@map("idempotency_keys")
}

// ── Resume Builder ────────────────────────────────────────────────────────────
// An in-app, structured résumé the user composes from our templates, distinct
// from the uploaded-file `Resume`. Exporting one renders a PDF, stores it, and
// creates a normal `Resume` row so the document flows into ATS scoring and the
// "select résumé when applying" picker.
//
// Full rationale, field-by-field: docs/RESUME_BUILDER_DATA_MODEL.md

enum ResumeLineSpacing {
  SINGLE // 1.0
  DEFAULT // 1.15
  WIDE // 1.5
}

enum ResumeMargin {
  NARROW // 0.5"
  NORMAL // 0.75"
  WIDE // 1.0"
}

enum ResumeDocumentStatus {
  DRAFT
  FINALIZED
}

/// A résumé design WE author and seed. Internal reference data: no owner column,
/// nothing here is user-writable, and there is no user-facing create/update route.
/// `layoutConfig` is authored by us and read by the renderer.
model ResumeTemplate {
  id            String  @id @default(uuid())
  name          String  @unique
  category      String // "ats-friendly" | "modern" | "creative"
  thumbnailUrl  String?
  isAtsFriendly Boolean @default(true)
  layoutConfig  Json // section order + styling rules the renderer reads
  isActive      Boolean @default(true)

  documents ResumeDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, category])
  @@map("resume_templates")
}

model ResumeDocument {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String
  templateId String
  template   ResumeTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  // Presentation controls (the reference screenshot's knobs).
  /// A PRESET KEY from a known set (e.g. "default" | "navy" | "forest"), NOT a
  /// free-form hex value. The DTO validates membership; the column deliberately
  /// stays a plain String so the preset list can grow, or its hex values change,
  /// without a migration.
  colorScheme String            @default("default")
  lineSpacing ResumeLineSpacing @default(DEFAULT)
  margin      ResumeMargin      @default(NORMAL)
  fontFamily  String?

  status ResumeDocumentStatus @default(DRAFT)

  // ── Résumé header ─────────────────────────────────────────────────────────
  // SNAPSHOTTED from Profile/User at creation, then owned by the document and
  // independently editable — a résumé tailored for one application must be able
  // to differ from the master profile. Never re-read from Profile afterwards.
  fullName     String?
  email        String?
  phone        String?
  location     String?
  linkedinUrl  String?
  portfolioUrl String?

  /// The `Resume` row produced by the MOST RECENT export, if any — a single FK,
  /// not a history. Re-exporting soft-deletes the previously linked `Resume` and
  /// repoints this, so the user's résumé picker only ever shows one current file
  /// per document.
  ///
  /// SetNull, NOT Cascade, and the direction matters: deleting the `Resume`
  /// leaves the document intact and merely unlinked. Deleting the DOCUMENT does
  /// NOT touch the exported `Resume`. There is no cascade in either direction
  /// between a document and its exported résumé.
  exportedResumeId String?
  exportedResume   Resume? @relation("ResumeBuilderExport", fields: [exportedResumeId], references: [id], onDelete: SetNull)

  summary        ResumeDocumentSummary?
  experiences    ResumeDocumentExperience[]
  educations     ResumeDocumentEducation[]
  skills         ResumeDocumentSkill[]
  certifications ResumeDocumentCertification[]
  projects       ResumeDocumentProject[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([templateId])
  @@map("resume_documents")
}

/// 1:1 with the document. A single block of text, so no `order`.
model ResumeDocumentSummary {
  id               String         @id @default(uuid())
  resumeDocumentId String         @unique
  resumeDocument   ResumeDocument @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resume_document_summaries")
}

model ResumeDocumentExperience {
  id               String         @id @default(uuid())
  resumeDocumentId String
  resumeDocument   ResumeDocument @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)

  order Int

  company      String
  title        String
  /// Not importable — `Experience` has no location column. User-entered.
  location     String?
  startDate    DateTime
  endDate      DateTime?
  isCurrentJob Boolean   @default(false)
  description  String?
  technologies String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeDocumentId, order])
  @@map("resume_document_experiences")
}

model ResumeDocumentEducation {
  id               String         @id @default(uuid())
  resumeDocumentId String
  resumeDocument   ResumeDocument @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)

  order Int

  institution  String
  degreeLevel  DegreeLevel
  fieldOfStudy String
  startDate    DateTime
  endDate      DateTime?
  gpa          Float?
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeDocumentId, order])
  @@map("resume_document_educations")
}

/// Denormalized on purpose: the display name is copied, not FK'd to `Skill`, so
/// the document is a stable snapshot and stays editable off-catalogue.
model ResumeDocumentSkill {
  id               String         @id @default(uuid())
  resumeDocumentId String
  resumeDocument   ResumeDocument @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)

  order Int

  name             String
  proficiencyLevel String? // BEGINNER | INTERMEDIATE | ADVANCED | EXPERT

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeDocumentId, order])
  @@map("resume_document_skills")
}

model ResumeDocumentCertification {
  id               String         @id @default(uuid())
  resumeDocumentId String
  resumeDocument   ResumeDocument @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)

  order Int

  name           String
  issuer         String
  issueDate      DateTime
  expirationDate DateTime?
  credentialId   String?
  credentialUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeDocumentId, order])
  @@map("resume_document_certifications")
}

/// Builder-only: there is no `Project` model to import from, so this section is
/// manual-entry until a profile-side equivalent exists.
model ResumeDocumentProject {
  id               String         @id @default(uuid())
  resumeDocumentId String
  resumeDocument   ResumeDocument @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)

  order Int

  name         String
  description  String?
  technologies String[]
  url          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeDocumentId, order])
  @@map("resume_document_projects")
}

// ── Job Tracker ────────────────────────────────────────────────────────────────

/// Where a tracked job sits on the user's own board.
///
/// DELIBERATELY NOT `ApplicationStatus`. That enum records what an EMPLOYER decided, and
/// the lifecycle enforces it: `EMPLOYER_SETTABLE_STATUSES` is SCREENING/INTERVIEW/OFFER/
/// REJECTED and a candidate asserting one is refused by the chokepoint. A drag-and-drop
/// board is the opposite — the user moves their own card freely, and what it means is
/// "this is where I think I am", not "this is what the employer recorded".
///
/// Reusing ApplicationStatus would either break the tracker (every drag refused) or break
/// the pipeline (a candidate writing INTERVIEW into an employer's board). Same lesson as
/// ARCHIVED, which was a shared status until one party's housekeeping started overwriting
/// the other party's record.
enum TrackedJobStage {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

/// A job the user is tracking themselves, on the Job Tracker board.
///
/// WHY THIS IS NOT AN `Application`. Applications are for jobs applied to INSIDE JobFits:
/// an employer receives them, drives the status, and the server REFUSES an in-app
/// application to an EXTERNAL job because it would go nowhere. Tracked jobs are the other
/// half of a real job hunt — postings applied to on bongthom, jobnet, LinkedIn or by
/// email, where no employer exists here to report anything back. The user is the only
/// source of truth, so the user owns the stage.
///
/// THE SNAPSHOT IS THE POINT. `title`/`companyName`/`url` are copied, not read through
/// `jobId`. A tracked card must survive the posting being taken down, re-ingested, or
/// never having been in our database at all (saved from the extension, or typed in by
/// hand). `jobId` is a convenience link when we happen to know the posting, never the
/// source of the card's content.
model TrackedJob {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Set when the card came from a posting we hold. NULL for anything typed in or saved
  /// from elsewhere. onDelete: SetNull — losing the posting must not lose the card.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Snapshot of what the user is tracking. Never re-read from `job`.
  title       String
  companyName String
  url         String?
  location    String?

  stage TrackedJobStage @default(SAVED)

  /// Order within a column. Drag-and-drop reorders inside a stage as well as between
  /// stages, so position is per (user, stage) and is rewritten on every move.
  position Int @default(0)

  /// The user's own notes about this hunt. Optional everywhere — the board is useful
  /// before any of it is filled in.
  minSalary Int?
  maxSalary Int?
  notes     String?

  /// When the user says they applied. Not derived from `stage`: someone can drag a card
  /// straight to INTERVIEW for a job they applied to weeks ago outside the product.
  appliedAt  DateTime?
  /// Hidden from the board without being deleted — the "Archived" view in the UI.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One card per known posting per user. NULLs are distinct in Postgres, so any number
  /// of hand-entered cards coexist — the same trick Job uses for (source, externalId).
  @@unique([userId, jobId])
  /// The board query is always "this user's, by stage, in order".
  @@index([userId, stage, position])
  @@index([userId, archivedAt])
  @@map("tracked_jobs")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through the transaction-mode pooler (6543).
  url       = env("DATABASE_URL")
  // Migrations and introspection need a session-mode connection (5432).
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  name                     String                    @default("")
  passwordHash             String                    @default("")
  role                     UserRole                  @default(JOB_SEEKER)
  avatarUrl                String?
  isActive                 Boolean                   @default(true)
  emailVerified            Boolean                   @default(false)
  verificationCode         String?
  verificationCodeExpiry   DateTime?
  passwordResetCode        String?
  passwordResetCodeExpiry  DateTime?
  lastLogin                DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  subscriptionTier         SubscriptionTier          @default(FREE)
  movedApplicationStages   ApplicationStageHistory[] @relation("MovedByUser")
  reviewedApplications     Application[]             @relation("ReviewedByEmployer")
  applications             Application[]
  auditLogs                AuditLog[]                @relation("AdminAuditLogs")
  certifications           Certification[]
  educations               Education[]
  employerProfile          EmployerProfile?
  experiences              Experience[]
  idempotencyKeys          IdempotencyKey[]
  jobSeekerProfile         JobSeekerProfile?
  postedJobs               Job[]                     @relation("PostedByEmployer")
  matchLabels              MatchLabel[]
  matchReports             MatchReport[]
  notifications            Notification[]
  offerMessages            OfferMessage[]            @relation("OfferMessages")
  extendedOffers           Offer[]                   @relation("ExtendedOffers")
  profile                  Profile?
  recommendations          Recommendation[]
  refreshTokens            RefreshToken[]
  resumeDocuments          ResumeDocument[]
  resumes                  Resume[]
  saved_external_jobs      saved_external_jobs[]
  savedJobs                SavedJob[]
  trackedJobs              TrackedJob[]
  acknowledgedSystemEvents SystemEvent[]             @relation("AcknowledgedSystemEvents")
  analytics                UserAnalytics?
  skills                   UserSkill[]

  @@index([email])
  @@index([role])
  @@index([subscriptionTier])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model Profile {
  id                     String                 @id @default(uuid())
  userId                 String                 @unique
  firstName              String
  lastName               String
  phone                  String?
  photoUrl               String?
  bio                    String?
  headline               String?
  city                   String?
  state                  String?
  country                String?
  latitude               Float?
  longitude              Float?
  desiredJobLevels       JobLevel[]
  desiredRemoteTypes     RemoteType[]
  desiredEmploymentTypes EmploymentType[]
  desiredIndustries      String[]
  minSalary              Int?
  maxSalary              Int?
  salaryCurrency         String                 @default("USD")
  linkedinUrl            String?
  githubUrl              String?
  portfolioUrl           String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deletedAt              DateTime?
  embedding              Unsupported("vector(1024)")?
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profiles")
}

model Experience {
  id             String         @id @default(uuid())
  userId         String
  company        String
  title          String
  jobLevel       JobLevel
  employmentType EmploymentType
  industry       String
  description    String?
  isCurrentJob   Boolean        @default(false)
  startDate      DateTime
  endDate        DateTime?
  technologies   String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([company])
  @@map("experiences")
}

model Education {
  id           String      @id @default(uuid())
  userId       String
  institution  String
  degreeLevel  DegreeLevel
  fieldOfStudy String
  description  String?
  startDate    DateTime
  endDate      DateTime?
  gpa          Float?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([institution])
  @@map("educations")
}

model Certification {
  id             String    @id @default(uuid())
  userId         String
  name           String
  issuer         String
  credentialId   String?
  credentialUrl  String?
  issueDate      DateTime
  expirationDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("certifications")
}

model UserSkill {
  id                String    @id @default(uuid())
  userId            String
  skillId           String
  endorsementCount  Int       @default(0)
  proficiencyLevel  String    @default("INTERMEDIATE")
  yearsOfExperience Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  skill             Skill     @relation(fields: [skillId], references: [id])
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}

model UserAnalytics {
  id                        String    @id @default(uuid())
  userId                    String    @unique
  totalApplications         Int       @default(0)
  totalInterviews           Int       @default(0)
  totalOffers               Int       @default(0)
  applicationAcceptanceRate Float     @default(0)
  interviewAcceptanceRate   Float     @default(0)
  profileViewCount          Int       @default(0)
  lastProfileViewDate       DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_analytics")
}

model JobSeekerProfile {
  id          String       @id @default(uuid())
  userId      String       @unique
  firstName   String
  lastName    String
  bio         String?
  location    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchScores MatchScore[]

  @@map("job_seeker_profiles")
}

model EmployerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String
  lastName  String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employer_profiles")
}

model Company {
  id                 String                     @id @default(uuid())
  name               String                     @unique
  description        String?
  website            String?
  logoUrl            String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  city               String?
  country            String?
  deletedAt          DateTime?
  foundedYear        Int?
  glassdoorId        String?
  glassdoorRating    Float?
  glassdoorReviews   Int?
  industry           String?
  size               String?
  state              String?
  isVerified         Boolean                    @default(false)
  verificationMethod CompanyVerificationMethod?
  verifiedAt         DateTime?
  employers          EmployerProfile[]
  jobs               Job[]

  @@index([name])
  @@index([industry])
  @@index([isVerified])
  @@map("companies")
}

model Job {
  id                       String                   @id @default(uuid())
  companyId                String
  title                    String
  description              String
  status                   JobStatus                @default(DRAFT)
  remoteType               String
  location                 String?
  minSalary                Int?
  maxSalary                Int?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  postedByEmployerId       String?
  source                   String?
  externalId               String?
  externalUrl              String?
  lastSeenAt               DateTime?
  embedding                Unsupported("vector(1024)")?
  benefits                 String[]                 @default([])
  bonusPct                 Int?
  requirements             String[]                 @default([])
  responsibilities         String[]                 @default([])
  searchTsv                Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, ((COALESCE(title, ''::text) || ' '::text) || COALESCE(description, ''::text)))"))
  sourceType               JobSourceType            @default(INTERNAL)
  extractedRequirements    String[]                 @default([])
  requirementsExtractedAt  DateTime?
  requirementsGroundedness Float?
  employmentType           EmploymentType?
  experienceLevel          JobLevel?
  applications             Application[]
  skills                   JobSkill[]
  company                  Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedByEmployer         User?                    @relation("PostedByEmployer", fields: [postedByEmployerId], references: [id])
  matchLabels              MatchLabel[]
  matchScores              MatchScore[]
  recommendations          Recommendation[]
  savedBy                  SavedJob[]

  @@unique([source, externalId])
  @@index([postedByEmployerId])
  @@index([source])
  @@index([employmentType])
  @@index([experienceLevel])
  @@index([searchTsv], type: Gin)
  @@index([sourceType])
  @@map("jobs")
  trackedJobs      TrackedJob[]
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("saved_jobs")
}

model Resume {
  id               String              @id @default(uuid())
  userId           String
  fileName         String
  fileUrl          String
  fileSize         Int
  fileType         String
  title            String?
  isDefault        Boolean             @default(false)
  parsingStatus    ResumeParsingStatus @default(PENDING)
  parsingError     String?
  atsScore         Int?
  qualityScore     Int?
  version          Int                 @default(1)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  applications     Application[]
  parsedData       ParsedResumeData?
  builderDocuments ResumeDocument[]    @relation("ResumeBuilderExport")
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
  @@index([parsingStatus])
  @@map("resumes")
}

model ParsedResumeData {
  id             String   @id @default(uuid())
  resumeId       String   @unique
  fullName       String?
  email          String?
  phone          String?
  location       String?
  summary        String?
  experiences    String?
  educations     String?
  skills         String?
  certifications String?
  rawText        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  parsedBy       String?
  projects       String?
  promptVersion  String?
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("parsed_resume_data")
}

model Application {
  id                        String                    @id @default(uuid())
  userId                    String
  jobId                     String
  resumeId                  String?
  status                    ApplicationStatus         @default(SUBMITTED)
  appliedAt                 DateTime                  @default(now())
  notes                     String?
  coverLetter               String?
  employerNotes             String?
  reviewedByEmployerId      String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  deletedAt                 DateTime?
  screenedAt                DateTime?
  screenMatchScore          Float?
  screenRequirementsTotal   Int?
  screenRequirementsCovered Int?
  screenMissingRequirements String[]                  @default([])
  screenRequirementsSource  String?
  archivedByCandidateAt     DateTime?
  archivedByEmployerAt      DateTime?
  stageHistory              ApplicationStageHistory[]
  timeline                  ApplicationTimeline[]
  job                       Job                       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume                    Resume?                   @relation(fields: [resumeId], references: [id])
  reviewedByEmployer        User?                     @relation("ReviewedByEmployer", fields: [reviewedByEmployerId], references: [id])
  user                      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactPerson             ContactPerson?
  offer                     Offer?

  @@unique([userId, jobId])
  @@index([userId])
  @@index([status])
  @@index([reviewedByEmployerId])
  @@index([archivedByCandidateAt])
  @@index([archivedByEmployerAt])
  @@map("applications")
}

model Offer {
  id                   String         @id @default(uuid())
  applicationId        String         @unique
  status               OfferStatus    @default(EXTENDED)
  baseSalary           Int
  currency             String         @default("USD")
  signingBonus         Int?
  annualBonusPct       Float?
  equityShares         Int?
  equityPrice          Float?
  startDate            DateTime?
  responseDeadline     DateTime?
  /// DEPRECATED — superseded by OfferMessage. This single column was used as a
  /// conversation: the employer's note, with candidate replies appended as
  /// "[Candidate] …". It could not order, timestamp or attribute anything, appending
  /// meant rewriting the whole string, and the employer's own write path REPLACED it —
  /// so replying deleted the candidate's message. Migrated into OfferMessage and no
  /// longer written. Kept only so the migration is reversible.
  notes                String?
  extendedByEmployerId String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  decidedAt            DateTime?
  messages             OfferMessage[]
  application          Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  extendedByEmployer   User?          @relation("ExtendedOffers", fields: [extendedByEmployerId], references: [id])

  @@index([status])
  @@map("offers")
}

model OfferMessage {
  id           String             @id @default(uuid())
  offerId      String
  authorRole   OfferMessageAuthor
  authorUserId String?
  body         String
  /// When the RECIPIENT read it. One column is enough: the recipient is implied by
  /// authorRole, and "has the author read their own message" is not a question anyone asks.
  readAt       DateTime?
  createdAt    DateTime           @default(now())
  authorUser   User?              @relation("OfferMessages", fields: [authorUserId], references: [id])
  offer        Offer              @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, createdAt])
  @@index([offerId, readAt])
  @@map("offer_messages")
}

model ApplicationStageHistory {
  id             String             @id @default(uuid())
  applicationId  String
  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus
  movedByUserId  String?
  notes          String?
  createdAt      DateTime           @default(now())
  application    Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  movedByUser    User?              @relation("MovedByUser", fields: [movedByUserId], references: [id])

  @@index([applicationId])
  @@index([createdAt])
  @@map("application_stage_history")
}

model ApplicationTimeline {
  id            String            @id @default(uuid())
  applicationId String
  status        ApplicationStatus
  eventType     String
  description   String?
  eventDate     DateTime          @default(now())
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_timelines")
}

model ContactPerson {
  id            String      @id @default(uuid())
  applicationId String      @unique
  name          String
  email         String?
  phone         String?
  title         String?
  linkedinUrl   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("contact_persons")
}

model MatchScore {
  id                 String           @id @default(uuid())
  jobId              String
  jobSeekerProfileId String
  score              Float
  breakdown          Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  job                Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobSeekerProfile   JobSeekerProfile @relation(fields: [jobSeekerProfileId], references: [id], onDelete: Cascade)

  @@unique([jobId, jobSeekerProfileId])
  @@map("match_scores")
}

model Recommendation {
  id                String   @id @default(uuid())
  userId            String
  jobId             String
  score             Float
  breakdown         Json?
  reasonExplanation String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, score])
  @@map("recommendations")
}

model MatchReport {
  id         String   @id @default(uuid())
  userId     String
  externalId String
  source     String
  title      String
  company    String?
  payload    Json
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("match_reports")
}

model MatchLabel {
  id        String           @id @default(uuid())
  userId    String
  jobId     String
  label     MatchLabelValue
  reason    String?
  source    MatchLabelSource @default(HUMAN)
  category  String?
  seniority String?
  language  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@map("match_labels")
}

model Skill {
  id         String      @id @default(uuid())
  name       String      @unique
  slug       String      @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  jobs       JobSkill[]
  userSkills UserSkill[]

  @@map("skills")
}

model JobSkill {
  jobId   String
  skillId String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

/// One thing that happened, addressed to one user.
///
/// The notification module existed as three empty listener stubs and a service whose two
/// methods had empty bodies — there was nowhere for a notification to go. The employer
/// could only discover a candidate's negotiation message by happening to open the board.
///
/// Rows are written INSIDE the transaction that causes them (see
/// ApplicationTransitionService and OfferService), not from an event listener. An
/// @OnEvent handler fires on emit, which for a status change means it fires from inside an
/// open transaction that may still roll back — leaving the user notified of something that
/// never happened. Writing the row beside the audit rows makes the notification exactly as
/// true as the change it describes.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  /// In-app path to whatever this is about, e.g. "/offers" or "/applications/{id}".
  /// Null when there is nowhere useful to send the reader.
  link      String?
  /// Null until read. A timestamp rather than a boolean so "when did they see it?" is
  /// answerable — the mock feed this replaces could not survive a page reload at all.
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model Industry {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("industries")
}

/// System health alerts (Feature 1). Emitted by monitoring / health checks; admins
/// can acknowledge them from the dashboard.
model SystemEvent {
  id                    String              @id @default(uuid())
  eventType             SystemEventType
  severity              SystemEventSeverity @default(INFO)
  message               String
  details               Json?
  acknowledgedAt        DateTime?
  acknowledgedByAdminId String?
  createdAt             DateTime            @default(now())
  acknowledgedByAdmin   User?               @relation("AcknowledgedSystemEvents", fields: [acknowledgedByAdminId], references: [id])

  @@index([severity])
  @@index([createdAt])
  @@index([acknowledgedAt])
  @@map("system_events")
}

/// Email delivery events (Feature 3). Fed by the email provider (SendGrid/SES) webhook.
/// `notificationId` is a soft reference kept for future linkage — there is no
/// notifications table yet, so it is a plain nullable column (no FK).
model EmailEvent {
  id              String         @id @default(uuid())
  recipientEmail  String
  notificationId  String?
  eventType       EmailEventType
  reason          String?
  externalEventId String?
  createdAt       DateTime       @default(now())

  @@index([recipientEmail])
  @@index([createdAt])
  @@index([eventType])
  @@map("email_events")
}

/// Basic admin action log (Audit Logging). Intentionally minimal for the MVP —
/// no old/new values, IP, or free-text reason (Phase 2+).
model AuditLog {
  id           String            @id @default(uuid())
  adminId      String
  actionType   AuditActionType
  resourceType AuditResourceType
  resourceId   String?
  createdAt    DateTime          @default(now())
  admin        User              @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  key            String   @unique
  userId         String
  /// "POST /api/v1/saved-jobs" — method + path, so one key cannot straddle routes.
  endpoint       String
  requestHash    String
  responseStatus Int
  /// Null for handlers that return no body (e.g. a 204).
  responseBody   Json?
  createdAt      DateTime @default(now())
  /// createdAt + 24h. Indexed because the only query that reads it is the
  /// cleanup sweep's `deleteMany({ where: { expiresAt: { lt: now } } })`.
  expiresAt      DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("idempotency_keys")
}

/// A résumé design WE author and seed. Internal reference data: no owner column,
/// nothing here is user-writable, and there is no user-facing create/update route.
/// `layoutConfig` is authored by us and read by the renderer.
model ResumeTemplate {
  id            String           @id @default(uuid())
  name          String           @unique
  category      String
  thumbnailUrl  String?
  isAtsFriendly Boolean          @default(true)
  layoutConfig  Json
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  documents     ResumeDocument[]

  @@index([isActive, category])
  @@map("resume_templates")
}

model ResumeDocument {
  id               String                        @id @default(uuid())
  userId           String
  title            String
  templateId       String
  /// A PRESET KEY from a known set (e.g. "default" | "navy" | "forest"), NOT a
  /// free-form hex value. The DTO validates membership; the column deliberately
  /// stays a plain String so the preset list can grow, or its hex values change,
  /// without a migration.
  colorScheme      String                        @default("default")
  lineSpacing      ResumeLineSpacing             @default(DEFAULT)
  margin           ResumeMargin                  @default(NORMAL)
  fontFamily       String?
  status           ResumeDocumentStatus          @default(DRAFT)
  fullName         String?
  email            String?
  phone            String?
  location         String?
  linkedinUrl      String?
  portfolioUrl     String?
  /// The `Resume` row produced by the MOST RECENT export, if any — a single FK,
  /// not a history. Re-exporting soft-deletes the previously linked `Resume` and
  /// repoints this, so the user's résumé picker only ever shows one current file
  /// per document.
  ///
  /// SetNull, NOT Cascade, and the direction matters: deleting the `Resume`
  /// leaves the document intact and merely unlinked. Deleting the DOCUMENT does
  /// NOT touch the exported `Resume`. There is no cascade in either direction
  /// between a document and its exported résumé.
  exportedResumeId String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  deletedAt        DateTime?
  certifications   ResumeDocumentCertification[]
  educations       ResumeDocumentEducation[]
  experiences      ResumeDocumentExperience[]
  projects         ResumeDocumentProject[]
  skills           ResumeDocumentSkill[]
  summary          ResumeDocumentSummary?
  exportedResume   Resume?                       @relation("ResumeBuilderExport", fields: [exportedResumeId], references: [id])
  template         ResumeTemplate                @relation(fields: [templateId], references: [id])
  user             User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([templateId])
  @@map("resume_documents")
}

/// 1:1 with the document. A single block of text, so no `order`.
model ResumeDocumentSummary {
  id               String         @id @default(uuid())
  resumeDocumentId String         @unique
  content          String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  resumeDocument   ResumeDocument @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)

  @@map("resume_document_summaries")
}

model ResumeDocumentExperience {
  id               String         @id @default(uuid())
  resumeDocumentId String
  order            Int
  company          String
  title            String
  /// Not importable — `Experience` has no location column. User-entered.
  location         String?
  startDate        DateTime
  endDate          DateTime?
  isCurrentJob     Boolean        @default(false)
  description      String?
  technologies     String[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  resumeDocument   ResumeDocument @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)

  @@index([resumeDocumentId, order])
  @@map("resume_document_experiences")
}

model ResumeDocumentEducation {
  id               String         @id @default(uuid())
  resumeDocumentId String
  order            Int
  institution      String
  degreeLevel      DegreeLevel
  fieldOfStudy     String
  startDate        DateTime
  endDate          DateTime?
  gpa              Float?
  description      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  resumeDocument   ResumeDocument @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)

  @@index([resumeDocumentId, order])
  @@map("resume_document_educations")
}

/// Denormalized on purpose: the display name is copied, not FK'd to `Skill`, so
/// the document is a stable snapshot and stays editable off-catalogue.
model ResumeDocumentSkill {
  id               String         @id @default(uuid())
  resumeDocumentId String
  order            Int
  name             String
  proficiencyLevel String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  resumeDocument   ResumeDocument @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)

  @@index([resumeDocumentId, order])
  @@map("resume_document_skills")
}

model ResumeDocumentCertification {
  id               String         @id @default(uuid())
  resumeDocumentId String
  order            Int
  name             String
  issuer           String
  issueDate        DateTime
  expirationDate   DateTime?
  credentialId     String?
  credentialUrl    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  resumeDocument   ResumeDocument @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)

  @@index([resumeDocumentId, order])
  @@map("resume_document_certifications")
}

/// Builder-only: there is no `Project` model to import from, so this section is
/// manual-entry until a profile-side equivalent exists.
model ResumeDocumentProject {
  id               String         @id @default(uuid())
  resumeDocumentId String
  order            Int
  name             String
  description      String?
  technologies     String[]
  url              String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  resumeDocument   ResumeDocument @relation(fields: [resumeDocumentId], references: [id], onDelete: Cascade)

  @@index([resumeDocumentId, order])
  @@map("resume_document_projects")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model saved_external_jobs {
  id          String   @id
  userId      String
  source      String
  externalId  String
  title       String
  company     String?
  description String?
  url         String?
  salary      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  users       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId])
}

